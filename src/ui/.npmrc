# .npmrc
engine-strict=true

# Supply-chain hardening: refuse to resolve a package version published less
# than 7 days ago, so a compromised-maintainer release has to survive a week of
# public scrutiny before it can enter a build. Flagged as a HIGH finding by both
# SRT and ASH (semgrep npm-missing-minimum-release-age).
#
# Honoured by npm >= 11.10; older clients ignore the key with a warning, so this
# is safe to set while `engines.npm` still allows >=10. `npm ci` installs from
# the committed lockfile and is unaffected either way — this constrains the
# `npm install` that ADDS or UPGRADES a dependency, which is exactly the moment
# the risk exists. To take a just-published release deliberately, override the
# age on that single command with npm's corresponding CLI flag set to zero
# (spelled out rather than written literally here, because the semgrep rule that
# audits this file reads any low value on any line — comments included — as the
# effective setting and re-reports it as a HIGH finding).
min-release-age=7
