# Generated / regenerable artifacts — keep source of truth, not binaries.
# NOTE: gitignore patterns do NOT support inline comments; keep comments on their own lines.

# PDFs + truth.json regenerated by gen_corpus.py (deterministic)
corpus/docs/
# config variants regenerated by make_configs.py
corpus/configs/
**/__pycache__/
# raw per-run runmaps; scored summaries are kept (see un-ignores below)
results/run-*/
# ad-hoc classification-bench runs: `run_classification_bench.py` writes
# results/clsconf-<stamp>/, which matched neither the ignore above nor the
# keep patterns below, so an ordinary measurement run turns up as untracked
# files in `git status` and is one `git add -A` away from the tree. A run worth keeping
# is promoted to results/<release>/<suite>/ like every other suite's.
results/clsconf-*/

# KEEP (committed, tracked) — scored results live at results/<release>/<suite>/
# (one release dir per release; see results/RETENTION.md)
!results/baseline.json
!results/*/*/summary.json
!results/*/*/summary.csv
!results/*/*/cell_stats.csv
!results/*/*/meta.json
!paper/figures/*.png
