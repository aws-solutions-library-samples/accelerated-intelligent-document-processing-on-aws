.env
.aws-sam
build.toml
model.tar.gz
.checksum
.checksums/
.build_checksum
.lib_checksum
# Zero-byte flock target for the UI make targets that share src/ui/node_modules
# (scripts/ui_deps_lock.sh). It holds no state and is never read; the kernel drops
# the lock when the holder exits, so a leftover file needs no cleanup. Kept OUT of
# src/ui deliberately — `ui-lint` caches on a checksum of that directory.
.ui-deps.lock

# Build artifacts - backup files from publish.py
*.pre-build-backup
.vscode/
.DS_Store
dist/
.sav/
.delete/
.data/
*.egg-info/
build/
# CDK synth output. pyrightconfig.json excludes `**/cdk.out` as build output at any
# depth, and that claim rests on an ignore rule covering it: without one a cdk.out/
# holding committed Python could appear and be dropped from `make typecheck` with no
# edit to any file a reviewer reads. test_pyright_config.py computes that per member.
cdk.out/
__pycache__
*.code-workspace
.ruff_cache
.kiro
notebooks/examples/data
.idea/
.srt/
# SRT converts notebooks to scripts (jupyter nbconvert --output "<nb>-converted")
# to run bandit on them, and only cleans up the .py form; notebooks missing
# language_info.file_extension get a .txt instead, which is left behind.
*-converted.py
*-converted.txt
*tmp-dev-assets*
scratch/
.mcp.json

# Node.js / npm
node_modules/
package-lock.json
# Allow the docs-site lock file (needed by GitHub Pages workflow for `npm ci` and dep caching)
!docs-site/package-lock.json
# Allow Feature Platform UI lock files (feature-template is the template
# source; bundled OSS features like sample-feature are built in CI with
# `npm ci`, which requires a committed lock file)
!feature-platform/*/feature-ui/package-lock.json

# Jupyter
.ipynb_checkpoints/

# Docs site (Astro Starlight) - build artifacts and symlinks
docs-site/.astro/
docs-site/dist/
docs-site/src/content/docs/*.md
docs-site/src/content/docs/extensions/
docs-site/src/content/docs/benchmarking/
docs-site/src/content/docs/release-validation/
docs-site/src/content/images
docs-site/public/images
docs-site/public/analyst-reports

# Type checking
pyrightconfig.temp.json
.pyright/

# Python virtual environments
.venv/
.venv-*/
venv/

#Temp notebook data
output/*
*.log
dataset
venv-*/
notebooks/doc-split-metrics-exp/
# SAM CLI config (may contain sensitive ARNs)
samconfig.toml
..bfg-report
.git-rewrite

# Cline memory bank (session-specific, not project source)
memory-bank/

# Claude agent workspace artefacts (plans/specs/transcripts)
.claude/superpowers/plans/
.claude/superpowers/specs/

# NOTE: .claude/settings.json is deliberately NOT ignored. It is the shared,
# reviewable project settings file — it carries the PreToolUse hook that keeps
# internal-only content out of commit messages and PR bodies, and a hook nobody
# can check in protects nobody. Personal overrides belong in
# .claude/settings.local.json, which is ignored (globally, and below).
.claude/settings.local.json

# Private feature trees — proprietary subscription features and the legacy
# products/ tree live in the separate idp-extensions repo, not the open-source
# repo. The public Feature Platform (host plumbing + feature-template + SDK)
# lives under feature-platform/ and lib/idp_feature_sdk/ and IS tracked.
products/
subscription-features/

# Feature Platform build artifacts (generated by SAM / npm / idp-feature-cli)
feature-platform/**/.aws-sam/
feature-platform/**/node_modules/
feature-platform/**/dist/

# Feature Platform catalog manifest — generated by `idp-cli publish` (merges
# bundled OSS features + config_library/marketplace-catalog.yaml). Never
# hand-edited or committed; marketplace-catalog.yaml is the checked-in source.
config_library/catalog.json
# Sample-document manifest — generated by `idp-cli publish` (scans samples/).
# Build artifact synced to the ConfigurationBucket at deploy time and read by
# the Quick Start agent's list_sample_documents tool; never hand-edited.
config_library/samples-manifest.json

.claude/worktrees/

# Stack-test reports now default under ./scratch (already gitignored above);
# these root paths are kept ignored in case someone passes an explicit
# REPORT_DIR=./api-test-results or ./zap-reports.
api-test-results/
zap-reports/

# Per-root JUnit XML plus the run summary that `make test`
# (scripts/run_all_tests.py) writes. One machine's run, not a repository fact —
# and the XML records that machine's hostname. The standing-failure verdict is
# decided in the process that produced these, so nothing reads them back.
/test-reports/

# The same artifacts one directory down, plus coverage's own files. `make test-cicd
# -C lib/idp_common_pkg` writes lib/idp_common_pkg/test-reports/, which the
# root-anchored pattern above does not match, and coverage leaves its binary data
# file in the working directory beside it. Neither was tracked nor ignored, so a
# `git add -A` picked .coverage up and committed it. Unanchored deliberately: the
# whole point is to catch the copy under lib/ that the entry above misses.
.coverage
.coverage.*
test-reports/
htmlcov/
.pytest_cache/

# Local scratch / capture artifacts — never committed. Some contain customer
# references from live-stack captures and must never reach a fork or upstream.
.playwright-mcp/
proto-*.png
proto2-*.png
proto3-*.png
live-*.png
live-testsets-snapshot.md
# scratch/ux-recordings/ (covered by scratch/ above) holds narrated video and
# frames of live stacks from scripts/ux_recorder.py — real documents, never committed.

# draw.io editor backup files
*.bkp
.$*

# Z3 development/test artifacts
Dockerfile.z3-github
docs/design/
insurance-underwriting-demo/
notebook/
test_z3/
*.whl

# Generated by scripts/sdlc/ai_mr_review.py: the review text posted to each MR,
# plus a per-run summary. Output, not source.
ai-reviews/

# Also written by scripts/sdlc/ai_mr_review.py, into the review worktree: the
# diff, the metadata and `.ai-review/base/`, which is a WHOLE copy of the tree at
# the merge base. Being gitignored is what keeps that second copy out of
# `scripts/tests/repo_files.tracked_paths`, whose whole premise is that asking git
# cannot see a stale copy of the repository (it lists `--others`, so untracked is
# not enough). Every repo-wide gate discovers through it, and without this line
# each one reads the pre-change tree as if it were part of the branch —
# so a defect the branch FIXES is reported against it. Pinned by
# `scripts/tests/test_repo_walk_guards_prune_local_work.py`.
.ai-review/

# CI run artifacts of the integration_tests job, written into the runner
# workspace by scripts/sdlc/integration_test_deployment.py and its after_script.
# aws_after_script_creds.env holds a LIVE AWS session — it must never be
# committed, and the job shreds it on the way out.
aws_after_script_creds.env
monitor_handoff.txt
pipeline_execution_id.txt
codebuild_logs.txt
deployment_summary.txt
