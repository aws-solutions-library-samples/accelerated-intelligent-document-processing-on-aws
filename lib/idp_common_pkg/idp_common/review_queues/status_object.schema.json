{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aws-solutions-library-samples/accelerated-intelligent-document-processing-on-aws/review-status-1.1.json",
  "title": "IDP review status object",
  "description": "s3://<OutputBucket>/<documentKey>/review/status.json, written by idp_common.review_queues. See idp_common/review_queues/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_key",
    "status",
    "sequence",
    "cycle_id",
    "profile",
    "queue",
    "reasons",
    "reason_count",
    "sections_in_review",
    "escalated",
    "timestamps"
  ],
  "$defs": {
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": { "type": "string" },
        "manifest_uri": { "type": ["string", "null"] }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "section_id", "score", "threshold"],
      "properties": {
        "kind": {
          "enum": [
            "low_confidence",
            "blueprint_confidence",
            "missing_required",
            "extraction_failed"
          ]
        },
        "section_id": { "type": "string" },
        "field": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "score": { "type": "number" },
        "threshold": { "type": "number" }
      }
    },
    "policyFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "policy", "name", "reason", "pages"],
      "properties": {
        "rule_id": { "type": "string" },
        "policy": { "type": "string" },
        "name": { "type": "string" },
        "reason": { "type": "string" },
        "pages": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "routedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "rule_id",
        "rule_label",
        "placed_queue",
        "fallback_reason",
        "reason",
        "reason_source",
        "policy_failures",
        "policy_failure_count"
      ],
      "properties": {
        "table_id": { "type": "string" },
        "rule_id": { "type": "string" },
        "rule_label": { "type": "string" },
        "placed_queue": { "type": "string" },
        "fallback_reason": { "type": "string" },
        "reason": { "type": "string" },
        "reason_source": { "type": "string" },
        "policy_failures": { "type": "array", "items": { "$ref": "#/$defs/policyFailure" } },
        "policy_failure_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.1" },
    "document_key": { "type": "string", "minLength": 1 },
    "status": { "enum": ["in_review", "complete", "rejected"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "cycle_id": { "type": "string", "pattern": "^[0-9a-f]{21}$" },
    "profile": { "type": "string" },
    "queue": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "machine_output": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runRef" }] },
    "final_output": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runRef" }] },
    "reasons": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/reason" } },
    "reason_count": { "type": "integer", "minimum": 0 },
    "sections_in_review": { "type": "array", "items": { "type": "string" } },
    "escalated": { "type": "boolean" },
    "disposition": { "enum": [null, "complete", "rejected"] },
    "reviewer": { "type": ["string", "null"] },
    "reject_reason": { "type": ["string", "null"] },
    "reject_note": { "type": ["string", "null"] },
    "routed_by": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/routedBy" }] },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enqueued_at", "updated_at"],
      "properties": {
        "enqueued_at": { "type": "string" },
        "disposed_at": { "type": ["string", "null"] },
        "finalized_at": { "type": ["string", "null"] },
        "updated_at": { "type": "string" }
      }
    }
  }
}
